  "author": "BackRunnner <dev@backrunner.top>",
  "license": "MIT",
  "keywords": [
    "cargo",
    "clean",
    "tui",
    "rust",
    "disk"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BackRunner/rucycle.git"
  },
  "homepage": "https://github.com/BackRunner/rucycle#readme",
  "bugs": {
    "url": "https://github.com/BackRunner/rucycle/issues"
  },
  "bin": {
